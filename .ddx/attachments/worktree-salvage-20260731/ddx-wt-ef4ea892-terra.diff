+// preCommitGateFingerprint returns a stable hash for the final staged tree and
+// hook inputs that back a pre-commit gate. It combines the commit tree SHA with
+// repo-local hook input files so stale explicit gate runs can be invalidated
+// when either the staged content or hook inputs change.
+func preCommitGateFingerprint(worktreePath, rev string) string {
+	worktreePath = strings.TrimSpace(worktreePath)
+	rev = strings.TrimSpace(rev)
+	if worktreePath == "" || rev == "" {
+		return ""
+	}
+
+	treeOut, err := internalgit.Command(context.Background(), worktreePath, "rev-parse", rev+"^{tree}").Output()
+	if err != nil {
+		return ""
+	}
+	parts := []string{strings.TrimSpace(string(treeOut))}
+	if hookInputs := preCommitHookInputsFingerprint(worktreePath); hookInputs != "" {
+		parts = append(parts, hookInputs)
+	}
+	return hashText(strings.Join(parts, "\x00"))
+}
+
+// preCommitHookInputsFingerprint hashes the repo-local inputs that shape the
+// staged pre-commit gate. The current contract only needs the repository's
+// Lefthook config and installed wrapper script.
+func preCommitHookInputsFingerprint(worktreePath string) string {
+	worktreePath = strings.TrimSpace(worktreePath)
+	if worktreePath == "" {
+		return ""
+	}
+
+	hookPath := ""
+	if out, err := internalgit.Command(context.Background(), worktreePath, "rev-parse", "--git-path", "hooks/pre-commit").Output(); err == nil {
+		hookPath = strings.TrimSpace(string(out))
+		if hookPath != "" && !filepath.IsAbs(hookPath) {
+			hookPath = filepath.Join(worktreePath, hookPath)
+		}
+	}
+
+	candidates := []struct {
+		label string
+		path  string
+	}{
+		{label: "lefthook.yml", path: filepath.Join(worktreePath, "lefthook.yml")},
+	}
+	if hookPath != "" {
+		candidates = append(candidates, struct {
+			label string
+			path  string
+		}{label: "git-hook-pre-commit", path: hookPath})
+	}
+
+	parts := make([]string, 0, len(candidates)*2)
+	for _, candidate := range candidates {
+		data, err := os.ReadFile(candidate.path)
+		if err != nil {
+			continue
+		}
+		parts = append(parts, candidate.label, hashText(string(data)))
+	}
+	if len(parts) == 0 {
+		return ""
+	}
+	return hashText(strings.Join(parts, "\x00"))
+}
+
+func gateFingerprintMatches(expected, actual string) bool {
+	expected = strings.TrimSpace(expected)
+	actual = strings.TrimSpace(actual)
+	if expected == "" {
+		return true
+	}
+	return actual != "" && actual == expected
+}
